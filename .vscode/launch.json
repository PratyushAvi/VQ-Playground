{
  "version": "0.2.0",
  "configurations": [
    {
      // Starts the dev server if it is not already up, then opens Chrome with
      // the debugger attached: breakpoints in src/*.tsx work directly.
      "name": "Playground (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "web: dev server",
      "sourceMaps": true
    },
    {
      "name": "Playground (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "web: dev server",
      "sourceMaps": true
    },
    {
      // The Phase 0 headless harness -- same wasm code path, no browser.
      "name": "Headless run (Node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/run_wasm.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
